{
  "name": "klyaks",
  "productName": "Klyaks",
  "version": "1.0.0",
  "description": "Клякс — голосовой репетитор английского на Gemini Live",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-packager . Klyaks --platform=win32 --arch=x64 --out=dist --overwrite --asar --icon=build/icon.ico --ignore=^/config.json$ --ignore=^/data --ignore=^/dist --ignore=^/build --ignore=^/docs --ignore=[.]lnk$"
  },
  "devDependencies": {
    "@electron/packager": "^18.0.0",
    "electron": "^38.0.0"
  }
}
