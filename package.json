{
  "name": "echo-tutor",
  "productName": "Echo",
  "version": "1.3.4",
  "description": "Echo — голосовой репетитор английского на Gemini Live",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "three": "^0.180.0"
  },
  "author": "Echo",
  "build": {
    "appId": "com.echo.tutor",
    "productName": "Echo",
    "executableName": "Echo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "renderer/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Echo-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Echo",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "supermegastonks1-code",
        "repo": "echo-tutor"
      }
    ]
  }
}
