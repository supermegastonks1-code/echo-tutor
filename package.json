{
  "name": "echo-tutor",
  "productName": "Echo",
  "version": "1.2.2",
  "description": "Echo — голосовой репетитор английского на Gemini Live",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-packager . Echo --platform=win32 --arch=x64 --out=dist --overwrite --asar --icon=build/icon.ico \"--ignore=^/config\\.json$\" \"--ignore=^/data\" \"--ignore=^/dist\" \"--ignore=^/build/\" \"--ignore=^/docs\" \"--ignore=\\.lnk$\" \"--ignore=^/CLAUDE\" \"--ignore=^/\\.git\" \"--ignore=^/\\.claude\""
  },
